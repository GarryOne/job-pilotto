# LF everywhere, also in Windows checkouts: the app ships these files (workflow templates, scripts)
# and edits the YAML by line.
* text=auto eol=lf
*.png binary
*.jpg binary
*.pdf binary
*.woff2 binary
*.sqlite binary
# Two sessions' updates of the ladder baseline merge per fixture (tools/merge-baseline.mjs; ship.sh registers the driver)
desktop/e2e/ladder-baseline.json merge=ladder-baseline
# A rebase over a moved extension version: the version line merges, the fingerprint is written once at ship time (tools/ship.sh, tools/merge-extension-version.mjs)
extension/manifest.json merge=ext-manifest
extension/fingerprint.json merge=ext-fingerprint
