# LF everywhere, also in Windows checkouts: the app ships these files (workflow templates, scripts)
# and edits the YAML by line.
* text=auto eol=lf
*.png binary
*.jpg binary
*.pdf binary
*.woff2 binary
*.sqlite binary
# Two sessions' updates of the ladder baseline merge per fixture (tools/merge-baseline.mjs; ship.sh registers the driver)
desktop/e2e/ladder-baseline.json merge=ladder-baseline
