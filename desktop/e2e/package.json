{
  "name": "job-pilotto-e2e",
  "private": true,
  "type": "module",
  "description": "End-to-end journey tests: Playwright drives the real Electron app (see README.md here). Kept out of ../package.json so the shipped app never bundles it.",
  "scripts": {
    "test": "node --test --test-reporter=spec test/*.test.mjs",
    "real-extension": "JP_LIVE=1 bash ../../tools/heavy-lock.sh real-extension node --test test/real-extension.test.mjs",
    "smoke": "node smoke.mjs",
    "eligibility-cases": "node eligibility-cases.mjs",
    "cv-facts-cases": "node cv-facts-cases.mjs",
    "recorded": "JP_REPLAY=1 bash ../../tools/heavy-lock.sh recorded-replay node --test --test-concurrency=1 test/recorded-pages.test.mjs",
    "recorded-both": "bash ../../tools/heavy-lock.sh recorded-replay bash recorded-both.sh",
    "recorded-map": "bash ../../tools/heavy-lock.sh recorded-map node replay-map.mjs",
    "wizard": "node suite.mjs wizard",
    "jobs": "node suite.mjs jobs",
    "interviews": "node suite.mjs interviews",
    "settings": "node suite.mjs settings",
    "employers": "node suite.mjs employers",
    "calendar": "node suite.mjs calendar",
    "focus": "node suite.mjs focus",
    "apply": "node suite.mjs apply",
    "quality": "node suite.mjs quality",
    "all": "node run-all.mjs",
    "row": "bash ../../tools/heavy-lock.sh row-replay node row.mjs",
    "rows": "bash ../../tools/heavy-lock.sh row-replay node row.mjs --all",
    "row-to-case": "bash ../../tools/heavy-lock.sh row-replay node row-to-case.mjs",
    "live": "JOB_PILOTTO_HEAVY_CLASS=proof bash ../../tools/heavy-lock.sh e2e-smoke node live.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "axe-core": "^4.13.0",
    "playwright-core": "^1.55.0"
  }
}
