{
  "name": "job-pilotto-desktop",
  "productName": "Job Pilotto",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "main": "start.js",
  "license": "SEE LICENSE IN ../LICENSE.md",
  "scripts": {
    "prestart": "npm install --no-audit --no-fund --silent && scripts/audiotee.sh && node scripts/stage.mjs",
    "start": "electron .",
    "pretest": "node scripts/stage.mjs",
    "test": "npm run lint && node --import ./test/no-live-site.mjs --test --test-reporter=./test/reporter-by-file.mjs test/*.test.js",
    "flows": "node e2e/flows-run.mjs",
    "twin": "node scripts/stage.mjs && node e2e/twin.mjs",
    "twin:drive": "node e2e/twin-drive.mjs",
    "live": "cd e2e && E2E_HEADED=1 LIVE=1 node run-all.mjs --only applyflows",
    "test:scenarios": "node scripts/stage.mjs && node --test test/app-scenarios.test.js",
    "build": "node scripts/stage.mjs --app && electron-builder --mac --publish never",
    "screenshots": "node scripts/stage.mjs && node scripts/screenshots.mjs",
    "gallery": "JOB_PILOTTO_DEMO=1 JOB_PILOTTO_PAGE=gallery.html JOB_PILOTTO_USER_DATA=${TMPDIR:-/tmp}/job-pilotto-gallery electron .",
    "build:win": "node scripts/stage.mjs --app && electron-builder --win --publish never",
    "ui-shots": "node scripts/stage.mjs && node scripts/ui-shots.mjs",
    "shot": "node scripts/stage.mjs && node scripts/shot.mjs",
    "drawer-shots": "node scripts/drawer-shots.mjs",
    "site-demo": "node scripts/stage.mjs && node scripts/site-demo.mjs",
    "apply-demo": "node scripts/apply-demo.mjs",
    "lint": "cd .. && eslint --config eslint.config.mjs --max-warnings 0 desktop extension",
    "mail-states": "node scripts/stage.mjs && node e2e/mail-states.mjs"
  },
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "electron-builder-squirrel-windows": "^26.15.3",
    "esbuild": "^0.25.12",
    "eslint": "^10.0.0",
    "globals": "^17.0.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "openai": "7.23.0",
    "@lydell/node-pty": "^1.2.0-beta.15",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/headless": "^6.0.0",
    "@xterm/xterm": "^6.0.0",
    "electron-log": "5.4.3",
    "libsodium-wrappers": "^0.7.16",
    "pdfjs-dist": "^6.3.289"
  },
  "description": "Job Pilotto: finds jobs that fit you, drafts your answers and fills forms; you submit.",
  "author": "Job Pilotto",
  "build": {
    "appId": "app.jobpilotto.desktop",
    "productName": "Job Pilotto",
    "directories": {
      "output": "dist"
    },
    "files": [
      "start.js",
      "main.js",
      "preload.cjs",
      "lib/**",
      "cv/**",
      "renderer/**",
      "demo/**",
      "shared/**",
      "package.json",
      "build-info.json",
      "!node_modules/@napi-rs/**",
      "!node_modules/pdfjs-dist/{legacy,types,web,image_decoders,wasm}/**",
      "!node_modules/**/*.{md,map,d.ts,d.mts,d.cts}",
      "!node_modules/**/{test,tests,__tests__,docs}/**"
    ],
    "extraResources": [
      {
        "from": "build/pilot",
        "to": "pilot"
      }
    ],
    "asarUnpack": [
      "node_modules/@lydell/**"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "icon": "assets/icon.png",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Job Pilotto records your interview calls (with everyone's agreement) to transcribe them on this Mac.",
        "NSAudioCaptureUsageDescription": "Job Pilotto records the call's audio to transcribe your interviews on this Mac.",
        "NSAppleEventsUsageDescription": "Job Pilotto switches Chrome to the application form Claude filled, so you can review it."
      }
    },
    "dmg": {
      "title": "Job Pilotto ${version}"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "shortcutName": "Job Pilotto"
    },
    "artifactName": "Job-Pilotto-${version}-${arch}.${ext}",
    "afterPack": "scripts/sign.cjs",
    "compression": "maximum",
    "electronLanguages": [
      "en",
      "en-US"
    ]
  }
}
