{
  // The one-off server proof (deleted again by the workflow): one standard-1 container, at most one instance.
  "name": "jp-server-proof",
  "main": "worker.js",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "containers": [
    {"class_name": "Proof", "image": "./Dockerfile", "image_build_context": "../..", "instance_type": "standard-1", "max_instances": 1}
  ],
  "durable_objects": {"bindings": [{"name": "PROOF", "class_name": "Proof"}]},
  "migrations": [{"tag": "v1", "new_sqlite_classes": ["Proof"]}]
}
