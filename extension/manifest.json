{
  "manifest_version": 3,
  "name": "Job Pilotto",
  "version": "0.2.0",
  "description": "Fills a job application from your drafted kit. You review and click Submit yourself.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Job Pilotto"
  },
  "options_page": "options.html",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "optional_host_permissions": [
    "https://*.greenhouse.io/*",
    "https://jobs.lever.co/*",
    "https://jobs.ashbyhq.com/*",
    "https://*.myworkdayjobs.com/*",
    "https://*.smartrecruiters.com/*",
    "https://apply.workable.com/*"
  ]
}
