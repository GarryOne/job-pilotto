{
  // The Ready to send runner (see worker.js). standard-1 (4 GiB): the fixture proof held three filled tabs in about 1.3 GB. max_instances is the number of nights at once (one owner, one night).
  // NOT DEPLOYED and not in .github/workflows/site.yml: it needs a Queue "ready-runs" and this Worker on the Cloudflare account (owner's yes). After it exists, the site Worker gets the service binding READY_RUNNER and the producer READY_QUEUE.
  "name": "www-ready-runner",
  "main": "worker.js",
  "compatibility_date": "2026-09-01",
  "workers_dev": false,
  "observability": {"enabled": true},   // keeps the consumer's errors and the container's log lines (counts and words only): 18 Oct 2026, a failed night left no trace
  "containers": [
    {"class_name": "ReadyRunner", "image": "../../hosted/ready-fill/Dockerfile", "image_build_context": "../..", "instance_type": "standard-1", "max_instances": 2}
  ],
  "durable_objects": {"bindings": [{"name": "READY", "class_name": "ReadyRunner"}]},
  "migrations": [{"tag": "v1", "new_sqlite_classes": ["ReadyRunner"]}],
  "queues": {"consumers": [{"queue": "ready-runs", "max_batch_size": 1, "max_batch_timeout": 5, "max_retries": 0, "max_concurrency": 2}]}
}
